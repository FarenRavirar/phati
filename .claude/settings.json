{
  "permissions": {
    "allow": [
      "Bash(ssh maruko ls:*)",
      "Bash(ssh maruko df:*)",
      "Bash(ssh maruko free:*)",
      "Bash(ssh maruko uptime:*)",
      "Bash(ssh maruko whoami:*)",
      "Bash(ssh maruko stat:*)",
      "Bash(ssh maruko wc:*)",
      "Bash(ssh maruko docker ps:*)",
      "Bash(ssh maruko docker logs:*)",
      "Bash(ssh maruko docker inspect:*)",
      "Bash(ssh maruko docker stats:*)",
      "Bash(ssh maruko docker images:*)",
      "Bash(ssh maruko systemctl status:*)",
      "Bash(ssh maruko docker exec phati-app-1 printenv PHATI_AMBIENTE)",
      "Bash(ssh maruko docker exec phati-app-1 printenv PHATI_MAPA_TESTE_ATIVO)",
      "Bash(ssh maruko docker exec phati-app-1 printenv PHATI_MAPA_FUNDO_GOOGLE_ATIVO)",
      "Bash(ssh maruko docker exec phati-app-1 sh -c 'test -n \"$PHATI_MAPA_GOOGLE_CHAVE\" && echo chave=presente || echo chave=ausente')"
    ],
    "deny": [
      "Bash(shutdown*)",
      "Bash(*; shutdown*)",
      "Bash(*&& shutdown*)",
      "Bash(*| shutdown*)",
      "Bash(*shutdown.exe*)",
      "Bash(*shutdown /*)",
      "Bash(*shutdown -*)",
      "Bash(*ssh maruko*shutdown*)",
      "Bash(*Stop-Computer*)",
      "Bash(*Restart-Computer*)",
      "Bash(*reboot*)",
      "Bash(*poweroff*)",
      "Bash(*commit --amend*)",
      "Bash(*push --force*)",
      "Bash(*push -f *)",
      "Bash(*ssh maruko*rm -rf*)",
      "Bash(*ssh maruko*.key*)",
      "Bash(*ssh maruko*.pem*)",
      "Bash(*ssh maruko*id_rsa*)",
      "Read(**/.env)",
      "Read(**/.env.[!e]*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr merge:*)",
      "Bash(*docker stop*)",
      "Bash(*docker rm*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker volume prune*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Bash(ssh maruko:*)",
      "Bash(scp *)",
      "Bash(rsync *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/caveman-resposta-final.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/sync-p.ps1\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/recursos-locais-gate.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk-read-gate.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk-enforce.js\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git-commit-msg-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/autorizacao-gate.js\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true
  }
}
