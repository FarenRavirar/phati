{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ],
      "env": {}
    },
    "magic": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "if(-not $env:API_KEY_21ST){$env:API_KEY_21ST=[Environment]::GetEnvironmentVariable(\"API_KEY_21ST\",\"User\")}; npx -y @21st-dev/magic@0.2.3"
      ]
    }
  }
}
